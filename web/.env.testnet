# Public settings for the NEAR testnet pilot. Nothing here is secret.
# Used by `npm run dev:testnet` and `npm run build:testnet`.
VITE_NETWORK=testnet
# NEAR's own public endpoint is rate-limited to the point of refusing browsers; FastNEAR's free one isn't.
VITE_RPC_URL=https://test.rpc.fastnear.com
VITE_HERALD_CONTRACT=herald.testnet
VITE_DAO_ACCOUNT=herald-dao.sputnik-v2.testnet
VITE_DAO_NAME=Herald Pilot
